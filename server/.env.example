# Copy to .env (or set these in your hosting provider). Never commit real keys.
ANTHROPIC_API_KEY=your-anthropic-api-key
# The exact origin where Fabriqon is served (CORS allow-list)
ALLOWED_ORIGIN=https://your-fabriqon-domain.example.com
PORT=8787
# Optional
FABRIQON_MODEL=claude-opus-5-5
RATE_LIMIT_PER_MIN=20
